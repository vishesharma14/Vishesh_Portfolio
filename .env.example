# Environment variable names for this project. Values are intentionally empty.
# Copy this file to `.env.local` for local development and fill in real values there.
# `.env.local` is git-ignored. Never commit real keys or tokens.

# ---------------------------------------------------------------------------
# Browser (bundled into the client by Vite, so they are PUBLIC by design).
# Only values that are safe for anyone to see may use the VITE_ prefix.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server only (Vercel functions). NEVER prefix these with VITE_.
# ---------------------------------------------------------------------------

# Supabase admin access for server functions (bypasses row-level security)
SUPABASE_SERVICE_ROLE_KEY=

# AI chatbot
ANTHROPIC_API_KEY=
CHAT_MODEL=

# GitHub activity section
GITHUB_TOKEN=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact form email notifications (optional)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
